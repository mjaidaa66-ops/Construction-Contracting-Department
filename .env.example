# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRUCTURAL_AGENT_URL: Loopback URL for the standalone Windows CSI ETABS v20 OAPI agent.
STRUCTURAL_AGENT_URL="http://127.0.0.1:45820"

# STRUCTURAL_AGENT_TOKEN: Shared bearer secret matching BUNYAN_AGENT_TOKEN on Windows agent.
STRUCTURAL_AGENT_TOKEN=""

# ALLOW_REMOTE_STRUCTURAL_AGENT: Keep false in production to prevent SSRF outside loopback.
ALLOW_REMOTE_STRUCTURAL_AGENT="false"

# PORT: HTTP port injected by Cloud Run (defaults to 3000 locally, 8080 in Cloud Run).
PORT="8080"

# NODE_ENV: Set to "production" in Cloud Run so Express serves built dist/ assets.
NODE_ENV="production"

