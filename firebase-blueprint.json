{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Engineering platform user profile and role assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "engineer", "accountant"] },
        "companyName": { "type": "string", "maxLength": 160 },
        "licenseNumber": { "type": "string", "maxLength": 80 },
        "biometricRegistered": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "biometricRegistered", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "UAE construction project record including permit, financial, GIS, BIM, and takeoff data.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "projectType": { "type": "string", "enum": ["villa", "commercial_tower", "residential_complex", "warehouse", "infrastructure", "institutional"] },
        "status": { "type": "string", "enum": ["permitting", "under_construction", "suspended", "completed"] },
        "approvedBudget": { "type": "number" },
        "invoicedAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "retentionPercentage": { "type": "number" },
        "actualProgress": { "type": "number" },
        "plannedProgress": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "code", "name", "nameEn", "projectType", "status", "approvedBudget", "createdAt", "updatedAt"]
    },
    "GovernmentTransaction": {
      "title": "GovernmentTransaction",
      "description": "UAE/Sharjah municipal authority permit and inspection transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authority": { "type": "string", "enum": ["sharjah_municipality", "sewa", "szhp", "civil_defense", "planning_survey", "municipalities_affairs", "sharjah_housing"] },
        "transactionNumber": { "type": "string", "minLength": 1, "maxLength": 80 },
        "serviceName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "type": "string", "enum": ["approved", "in_review", "action_required", "pending_inspection"] },
        "reviewEngineer": { "type": "string", "maxLength": 120 },
        "officialPortalUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "authority", "transactionNumber", "serviceName", "status", "createdAt", "updatedAt"]
    },
    "DocumentManifest": {
      "title": "DocumentManifest",
      "description": "Metadata manifest for chunked engineering PDFs and blueprint images stored across 800KB Firestore chunks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "totalSize": { "type": "number" },
        "totalChunks": { "type": "number" },
        "chunkSizeBytes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "fileName", "mimeType", "totalSize", "totalChunks", "createdAt"]
    },
    "DocumentChunk": {
      "title": "DocumentChunk",
      "description": "800KB max base64 slice of an engineering document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "manifestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "index": { "type": "number" },
        "data": { "type": "string", "maxLength": 900000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "manifestId", "ownerId", "index", "data", "createdAt"]
    },
    "RateLibraryItem": {
      "title": "RateLibraryItem",
      "description": "UAE AED construction unit rate item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 20 },
        "category": { "type": "string", "maxLength": 40 },
        "nameAr": { "type": "string", "maxLength": 200 },
        "nameEn": { "type": "string", "maxLength": 200 },
        "unit": { "type": "string", "maxLength": 20 },
        "rateAed": { "type": "number" },
        "equipmentRate": { "type": "number" },
        "materialSpec": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "code", "category", "nameAr", "nameEn", "unit", "rateAed", "updatedAt"]
    },
    "CompanyProfile": {
      "title": "CompanyProfile",
      "description": "UAE engineering firm license, TRN, and contact profile synced across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "licenseNumber": { "type": "string", "minLength": 1, "maxLength": 80 },
        "municipalityClass": { "type": "string", "maxLength": 120 },
        "trnNumber": { "type": "string", "maxLength": 40 },
        "addressAr": { "type": "string", "maxLength": 300 },
        "addressEn": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "nameAr", "nameEn", "licenseNumber", "updatedAt"]
    },
    "ReportWorkspace": {
      "title": "ReportWorkspace",
      "description": "Per-user saved reports, favorites, print settings, templates, and print audit logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "savedReports": { "type": "array" },
        "customTemplates": { "type": "object" },
        "printSettings": { "type": "object" },
        "auditLogs": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "savedReports", "customTemplates", "printSettings", "auditLogs", "updatedAt"]
    },
    "StructuralProject": {
      "title": "StructuralProject",
      "description": "Structural Intelligence project metadata bridged to a Bunyan construction project.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bunyanProjectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "structuralSystem": { "type": "string", "maxLength": 200 },
        "designCode": { "type": "string", "maxLength": 200 },
        "activeRevisionId": { "type": "string", "maxLength": 128 },
        "revisionCount": { "type": "number" },
        "reliabilitySummary": { "type": "string", "enum": ["SOURCE_VERIFIED", "DERIVED", "UNVERIFIED", "MISSING", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "bunyanProjectId", "code", "name", "nameEn", "revisionCount", "reliabilitySummary", "createdAt", "updatedAt"]
    },
    "StructuralModel": {
      "title": "StructuralModel",
      "description": "Normalized structural model header imported from CSI ETABS v20 or exported tables.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceApplication": { "type": "string", "enum": ["CSI ETABS", "ETABS Exported Tables"] },
        "sourceVersion": { "type": "string", "maxLength": 64 },
        "sourceFileReference": { "type": "string", "maxLength": 400 },
        "originalUnits": { "type": "string", "maxLength": 40 },
        "normalizedUnits": { "type": "string", "maxLength": 40 },
        "coordinateSystem": { "type": "string", "maxLength": 64 },
        "modelLocked": { "type": "boolean" },
        "storyCount": { "type": "number" },
        "gridCount": { "type": "number" },
        "nodeCount": { "type": "number" },
        "frameCount": { "type": "number" },
        "areaCount": { "type": "number" },
        "materialCount": { "type": "number" },
        "sectionCount": { "type": "number" },
        "loadPatternCount": { "type": "number" },
        "loadCaseCount": { "type": "number" },
        "loadComboCount": { "type": "number" },
        "provenance": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "revisionId", "name", "sourceApplication", "sourceVersion", "originalUnits", "normalizedUnits", "provenance", "createdAt", "updatedAt"]
    },
    "StructuralImportJob": {
      "title": "StructuralImportJob",
      "description": "Auditable ETABS import job log and hash tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceMode": { "type": "string", "enum": ["ETABS_OAPI_LIVE", "ETABS_EXPORTED_TABLES"] },
        "sourceFileReference": { "type": "string", "maxLength": 400 },
        "sourceHash": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["PENDING", "RUNNING", "PREVIEW_READY", "CONFIRMED", "CANCELLED", "FAILED"] },
        "currentStep": { "type": "number" },
        "totalSteps": { "type": "number" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "errorMessage": { "type": "string", "maxLength": 500 },
        "retryCount": { "type": "number" },
        "reliabilitySummary": { "type": "string", "enum": ["SOURCE_VERIFIED", "DERIVED", "UNVERIFIED", "MISSING", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "revisionId", "sourceMode", "sourceHash", "status", "reliabilitySummary", "createdAt", "updatedAt"]
    },
    "StructuralElementsPacket": {
      "title": "StructuralElementsPacket",
      "description": "Normalized stories, grids, frames, areas, and load definitions for a structural revision.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "stories": { "type": "array" },
        "grids": { "type": "array" },
        "nodesCount": { "type": "number" },
        "frames": { "type": "array" },
        "areas": { "type": "array" },
        "loadPatterns": { "type": "array" },
        "loadCases": { "type": "array" },
        "loadCombinations": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "modelId", "revisionId", "stories", "grids", "nodesCount", "frames", "areas", "createdAt"]
    },
    "StructuralMaterialsPacket": {
      "title": "StructuralMaterialsPacket",
      "description": "Normalized structural material properties preserving raw and SI values.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "modelId", "revisionId", "items", "createdAt"]
    },
    "StructuralSectionsPacket": {
      "title": "StructuralSectionsPacket",
      "description": "Normalized frame and area section definitions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "modelId", "revisionId", "items", "createdAt"]
    },
    "StructuralResultsPacket": {
      "title": "StructuralResultsPacket",
      "description": "Analysis/design status and Phase 2 readiness packet for a structural revision.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "analysisResults": { "type": "array" },
        "designResults": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "modelId", "revisionId", "analysisResults", "designResults", "createdAt"]
    },
    "StructuralValidationRecord": {
      "title": "StructuralValidationRecord",
      "description": "Engineering completeness, consistency, and reliability validation output.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["PASSED", "PASSED_WITH_WARNINGS", "FAILED"] },
        "reliability": { "type": "string", "enum": ["SOURCE_VERIFIED", "DERIVED", "UNVERIFIED", "MISSING", "FAILED"] },
        "checkedAt": { "type": "string" },
        "errorCount": { "type": "number" },
        "warningCount": { "type": "number" },
        "issues": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "revisionId", "status", "reliability", "errorCount", "warningCount", "issues", "createdAt"]
    },
    "StructuralModelRevision": {
      "title": "StructuralModelRevision",
      "description": "Immutable versioned structural model revision snapshot.",
      "type": "object",
