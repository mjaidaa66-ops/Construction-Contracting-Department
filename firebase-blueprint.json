      "required": ["id", "ownerId", "projectId", "modelId", "revisionNumber", "sourceHash", "immutable", "reliability", "createdAt"]
    },
    "StructuralReport": {
      "title": "StructuralReport",
      "description": "Structural engineering audit, validation, and model inventory report.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "revisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
