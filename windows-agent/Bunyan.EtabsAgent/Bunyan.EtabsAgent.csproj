<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Bunyan.EtabsAgent</RootNamespace>
    <AssemblyName>Bunyan.EtabsAgent</AssemblyName>
    <EtabsInstallDir Condition="'$(EtabsInstallDir)' == ''">C:\Program Files\Computers and Structures\ETABS 20</EtabsInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ETABSv1">
      <HintPath>$(EtabsInstallDir)\ETABSv1.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Configuration" />
  </ItemGroup>
</Project>
