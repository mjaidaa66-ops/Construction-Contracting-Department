rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'mjaidaa66@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(ownerId) {
      return isEmailVerified() && request.auth.uid == ownerId;
    }

    // Connectivity probe document (requires verified email for authenticated cloud-path verification)
    match /test/connection {
      allow get: if isEmailVerified();
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if false;
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // Users Collection (PII isolated to owner or admin)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'biometricRegistered', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'companyName', 'licenseNumber', 'biometricRegistered', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['admin', 'engineer', 'accountant']
        && data.biometricRegistered is bool
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 160))
        && (!('licenseNumber' in data) || (data.licenseNumber is string && data.licenseNumber.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isEmailVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role in ['engineer', 'accountant'] || isAdmin());
      allow update: if isValidId(userId)
        && isEmailVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'companyName', 'licenseNumber', 'biometricRegistered', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Projects Collection
    function isValidProject(data, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'code', 'name', 'nameEn', 'projectType', 'status', 'approvedBudget', 'invoicedAmount', 'paidAmount', 'retentionPercentage', 'actualProgress', 'plannedProgress', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'code', 'name', 'nameEn', 'category', 'projectType', 'status',
          'ownerName', 'ownerPhone', 'ownerEmail', 'ownerNationalId',
          'consultantOffice', 'consultantEngineer', 'consultantPhone', 'consultantLicenseNo',
          'residentEngineer', 'contractorBranch',
          'permitNumber', 'permitDate', 'permitExpiryDate', 'licensingAuthority',
          'approvedBudget', 'invoicedAmount', 'paidAmount', 'retentionPercentage',
          'actualProgress', 'plannedProgress',
          'phases', 'paymentMilestones', 'documents', 'gisData',
          'bimElements', 'takeoffSheets', 'takeoffMeasurements', 'takeoffSummaryConfig',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == projectId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 40
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 200
        && data.projectType in ['villa', 'commercial_tower', 'residential_complex', 'warehouse', 'infrastructure', 'institutional']
        && data.status in ['permitting', 'under_construction', 'suspended', 'completed']
        && data.approvedBudget is number && data.approvedBudget >= 0
        && data.invoicedAmount is number && data.invoicedAmount >= 0
        && data.paidAmount is number && data.paidAmount >= 0
        && data.retentionPercentage is number && data.retentionPercentage >= 0 && data.retentionPercentage <= 50
        && data.actualProgress is number && data.actualProgress >= 0 && data.actualProgress <= 100
        && data.plannedProgress is number && data.plannedProgress >= 0 && data.plannedProgress <= 100
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 200))
        && (!('ownerPhone' in data) || (data.ownerPhone is string && data.ownerPhone.size() <= 60))
        && (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 160))
        && (!('ownerNationalId' in data) || (data.ownerNationalId is string && data.ownerNationalId.size() <= 60))
        && (!('consultantOffice' in data) || (data.consultantOffice is string && data.consultantOffice.size() <= 200))
        && (!('consultantEngineer' in data) || (data.consultantEngineer is string && data.consultantEngineer.size() <= 160))
        && (!('consultantPhone' in data) || (data.consultantPhone is string && data.consultantPhone.size() <= 60))
        && (!('consultantLicenseNo' in data) || (data.consultantLicenseNo is string && data.consultantLicenseNo.size() <= 80))
        && (!('residentEngineer' in data) || (data.residentEngineer is string && data.residentEngineer.size() <= 160))
        && (!('contractorBranch' in data) || (data.contractorBranch is string && data.contractorBranch.size() <= 160))
        && (!('permitNumber' in data) || (data.permitNumber is string && data.permitNumber.size() <= 80))
        && (!('permitDate' in data) || (data.permitDate is string && data.permitDate.size() <= 40))
        && (!('permitExpiryDate' in data) || (data.permitExpiryDate is string && data.permitExpiryDate.size() <= 40))
        && (!('licensingAuthority' in data) || (data.licensingAuthority is string && data.licensingAuthority.size() <= 160))
        && (!('gisData' in data) || data.gisData is map)
        && (!('takeoffSummaryConfig' in data) || data.takeoffSummaryConfig is map)
        && (!('phases' in data) || (data.phases is list && data.phases.size() <= 50))
        && (!('paymentMilestones' in data) || (data.paymentMilestones is list && data.paymentMilestones.size() <= 50))
        && (!('documents' in data) || (data.documents is list && data.documents.size() <= 100))
        && (!('bimElements' in data) || (data.bimElements is list && data.bimElements.size() <= 500))
        && (!('takeoffSheets' in data) || (data.takeoffSheets is list && data.takeoffSheets.size() <= 50))
        && (!('takeoffMeasurements' in data) || (data.takeoffMeasurements is list && data.takeoffMeasurements.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(projectId)
        && isEmailVerified()
        && isValidProject(incoming(), projectId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isEmailVerified()
        && isValidProject(incoming(), projectId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerId)
            && existing().status != 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'name', 'nameEn', 'category', 'projectType', 'status',
              'ownerName', 'ownerPhone', 'ownerEmail', 'ownerNationalId',
              'consultantOffice', 'consultantEngineer', 'consultantPhone', 'consultantLicenseNo',
              'residentEngineer', 'contractorBranch',
              'permitNumber', 'permitDate', 'permitExpiryDate', 'licensingAuthority',
              'approvedBudget', 'invoicedAmount', 'paidAmount', 'retentionPercentage',
              'actualProgress', 'plannedProgress',
              'phases', 'paymentMilestones', 'documents', 'gisData',
              'bimElements', 'takeoffSheets', 'takeoffMeasurements', 'takeoffSummaryConfig',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(projectId) && (
        isAdmin() ||
        (isOwner(existing().ownerId) && existing().status != 'completed')
      );
    }

    // Government Transactions Collection
    function isValidGovernmentTransaction(data, txId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'authority', 'transactionNumber', 'serviceName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'authority', 'transactionNumber',
          'serviceName', 'serviceNameEn', 'status', 'submissionDate',
          'lastUpdatedDate', 'reviewEngineer', 'notes', 'officialPortalUrl',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == txId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.authority in ['sharjah_municipality', 'sewa', 'szhp', 'civil_defense', 'planning_survey', 'municipalities_affairs', 'sharjah_housing']
        && data.transactionNumber is string && data.transactionNumber.size() >= 1 && data.transactionNumber.size() <= 80
        && data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 200
        && (!('serviceNameEn' in data) || (data.serviceNameEn is string && data.serviceNameEn.size() <= 200))
        && data.status in ['approved', 'in_review', 'action_required', 'pending_inspection']
        && (!('submissionDate' in data) || (data.submissionDate is string && data.submissionDate.size() <= 40))
        && (!('lastUpdatedDate' in data) || (data.lastUpdatedDate is string && data.lastUpdatedDate.size() <= 40))
        && (!('reviewEngineer' in data) || (data.reviewEngineer is string && data.reviewEngineer.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('officialPortalUrl' in data) || (data.officialPortalUrl is string && data.officialPortalUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /government_transactions/{transactionId} {
      allow get: if isValidId(transactionId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(transactionId)
        && isEmailVerified()
        && isValidGovernmentTransaction(incoming(), transactionId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            exists(/databases/$(database)/documents/projects/$(incoming().projectId))
            && (get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid || isAdmin())
          ) ||
          (
            existsAfter(/databases/$(database)/documents/projects/$(incoming().projectId))
            && (getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid || isAdmin())
          )
        );
      allow update: if isValidId(transactionId)
        && isEmailVerified()
        && isValidGovernmentTransaction(incoming(), transactionId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerId)
            && existing().status != 'approved'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authority', 'transactionNumber', 'serviceName', 'serviceNameEn',
              'status', 'submissionDate', 'lastUpdatedDate', 'reviewEngineer',
              'notes', 'officialPortalUrl', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(transactionId) && (
        isAdmin() ||
        (isOwner(existing().ownerId) && existing().status != 'approved')
      );
    }

    // Document Manifests & Chunked Binary Storage (800KB base64 chunks)
    function isValidDocumentManifest(data, manifestId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'fileName', 'mimeType', 'totalSize', 'totalChunks', 'chunkSizeBytes', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'projectId', 'fileName', 'mimeType', 'totalSize', 'totalChunks', 'chunkSizeBytes', 'createdAt'])
        && data.id is string && data.id == manifestId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120
        && data.totalSize is number && data.totalSize >= 0 && data.totalSize <= 52428800
        && data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 100
        && data.chunkSizeBytes is number && data.chunkSizeBytes > 0 && data.chunkSizeBytes <= 900000
        && data.createdAt is timestamp;
    }

    function isValidDocumentChunk(data, manifestId, chunkId) {
      return data.keys().hasAll(['id', 'manifestId', 'ownerId', 'index', 'data', 'createdAt'])
        && data.keys().hasOnly(['id', 'manifestId', 'ownerId', 'index', 'data', 'createdAt'])
        && data.id is string && data.id == chunkId && data.id.size() <= 128
        && data.manifestId is string && data.manifestId == manifestId
        && data.ownerId is string && isValidId(data.ownerId)
        && data.index is number && data.index >= 0 && data.index < 100
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 900000
        && data.createdAt is timestamp;
    }

    match /document_manifests/{manifestId} {
      allow get: if isValidId(manifestId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(manifestId)
        && isEmailVerified()
        && isValidDocumentManifest(incoming(), manifestId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && (
          (
            exists(/databases/$(database)/documents/projects/$(incoming().projectId))
            && (get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid || isAdmin())
          ) ||
          (
            existsAfter(/databases/$(database)/documents/projects/$(incoming().projectId))
            && (getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid || isAdmin())
          )
        );
      allow update: if false;
      allow delete: if isValidId(manifestId) && (isOwner(existing().ownerId) || isAdmin());

      // Master Gate: Chunk access derives from parent DocumentManifest (supports atomic writeBatch create via existsAfter)
      match /chunks/{chunkId} {
        allow get: if isValidId(manifestId) && isValidId(chunkId)
          && isEmailVerified()
          && (get(/databases/$(database)/documents/document_manifests/$(manifestId)).data.ownerId == request.auth.uid || isAdmin());
        allow list: if isValidId(manifestId)
          && isEmailVerified()
          && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isValidId(manifestId) && isValidId(chunkId)
          && isEmailVerified()
          && isValidDocumentChunk(incoming(), manifestId, chunkId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && (
            (
              exists(/databases/$(database)/documents/document_manifests/$(manifestId))
              && get(/databases/$(database)/documents/document_manifests/$(manifestId)).data.ownerId == request.auth.uid
            ) ||
            (
              existsAfter(/databases/$(database)/documents/document_manifests/$(manifestId))
              && getAfter(/databases/$(database)/documents/document_manifests/$(manifestId)).data.ownerId == request.auth.uid
            )
          );
        allow update: if false;
        allow delete: if isValidId(manifestId) && isValidId(chunkId)
          && isEmailVerified()
          && (get(/databases/$(database)/documents/document_manifests/$(manifestId)).data.ownerId == request.auth.uid || isAdmin());
      }
    }

    // Rate Library Collection
    function isValidRateLibraryItem(data, rateId) {
      return data.keys().hasAll(['id', 'ownerId', 'code', 'category', 'nameAr', 'nameEn', 'unit', 'rateAed', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'code', 'category', 'nameAr', 'nameEn', 'unit', 'rateAed', 'equipmentRate', 'materialSpec', 'updatedAt'])
        && data.id is string && data.id == rateId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 20
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 200
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 200
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20
        && data.rateAed is number && data.rateAed >= 0
        && (!('equipmentRate' in data) || (data.equipmentRate is number && data.equipmentRate >= 0))
        && (!('materialSpec' in data) || (data.materialSpec is string && data.materialSpec.size() <= 200))
        && data.updatedAt is timestamp;
    }

    match /rate_library/{rateId} {
      allow get: if isValidId(rateId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(rateId)
        && isEmailVerified()
        && isValidRateLibraryItem(incoming(), rateId)
        && incoming().ownerId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(rateId)
        && isEmailVerified()
        && isValidRateLibraryItem(incoming(), rateId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'category', 'nameAr', 'nameEn', 'unit', 'rateAed', 'equipmentRate', 'materialSpec', 'updatedAt'])
          )
        );
      allow delete: if isValidId(rateId) && (isOwner(existing().ownerId) || isAdmin());
    }

    // Company Profiles Collection (Cross-device UAE company & TRN sync)
    function isValidCompanyProfile(data, profileId) {
      return data.keys().hasAll(['id', 'ownerId', 'nameAr', 'nameEn', 'licenseNumber', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'nameAr', 'nameEn', 'licenseNumber', 'municipalityClass',
          'trnNumber', 'addressAr', 'addressEn', 'phone', 'email', 'updatedAt'
        ])
        && data.id is string && data.id == profileId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 200
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 200
        && data.licenseNumber is string && data.licenseNumber.size() >= 1 && data.licenseNumber.size() <= 80
        && (!('municipalityClass' in data) || (data.municipalityClass is string && data.municipalityClass.size() <= 120))
        && (!('trnNumber' in data) || (data.trnNumber is string && data.trnNumber.size() <= 40))
        && (!('addressAr' in data) || (data.addressAr is string && data.addressAr.size() <= 300))
        && (!('addressEn' in data) || (data.addressEn is string && data.addressEn.size() <= 300))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.updatedAt is timestamp;
    }

    match /company_profiles/{profileId} {
      allow get: if isValidId(profileId) && (isOwner(profileId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(profileId)
        && isEmailVerified()
        && profileId == request.auth.uid
        && isValidCompanyProfile(incoming(), profileId)
        && incoming().ownerId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(profileId)
        && isEmailVerified()
        && isValidCompanyProfile(incoming(), profileId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'nameAr', 'nameEn', 'licenseNumber', 'municipalityClass',
              'trnNumber', 'addressAr', 'addressEn', 'phone', 'email', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(profileId) && (isOwner(existing().ownerId) || isAdmin());
    }

    // Reports & Printing Workspace Collection (Per-user saved reports, favorites, templates & audit logs)
    function isValidReportWorkspace(data, workspaceId) {
      return data.keys().hasAll(['id', 'ownerId', 'savedReports', 'customTemplates', 'printSettings', 'auditLogs', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'savedReports', 'customTemplates', 'printSettings', 'auditLogs', 'updatedAt'])
        && data.id is string && data.id == workspaceId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.savedReports is list && data.savedReports.size() <= 200
        && data.customTemplates is map
        && data.printSettings is map
        && data.auditLogs is list && data.auditLogs.size() <= 250
        && data.updatedAt is timestamp;
    }

    match /report_workspaces/{workspaceId} {
      allow get: if isValidId(workspaceId) && (isOwner(workspaceId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(workspaceId)
        && isEmailVerified()
        && workspaceId == request.auth.uid
        && isValidReportWorkspace(incoming(), workspaceId)
        && incoming().ownerId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(workspaceId)
        && isEmailVerified()
        && isValidReportWorkspace(incoming(), workspaceId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'savedReports', 'customTemplates', 'printSettings', 'auditLogs', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(workspaceId) && (isOwner(existing().ownerId) || isAdmin());
    }

    // ==================== STRUCTURAL INTELLIGENCE SUITE (PHASE 1) ====================

    function isValidReliability(val) {
      return val in ['SOURCE_VERIFIED', 'DERIVED', 'UNVERIFIED', 'MISSING', 'FAILED'];
    }

    function hasValidStructuralProjectParent(projectId) {
      return isValidId(projectId)
        && (
          (
            exists(/databases/$(database)/documents/structuralProjects/$(projectId))
            && (get(/databases/$(database)/documents/structuralProjects/$(projectId)).data.ownerId == request.auth.uid || isAdmin())
          ) ||
          (
            existsAfter(/databases/$(database)/documents/structuralProjects/$(projectId))
            && (getAfter(/databases/$(database)/documents/structuralProjects/$(projectId)).data.ownerId == request.auth.uid || isAdmin())
          )
        );
    }

    function isValidStructuralProject(data, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'bunyanProjectId', 'code', 'name', 'nameEn', 'revisionCount', 'reliabilitySummary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'bunyanProjectId', 'code', 'name', 'nameEn',
          'structuralSystem', 'designCode', 'activeRevisionId',
          'revisionCount', 'reliabilitySummary', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == projectId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.bunyanProjectId is string && isValidId(data.bunyanProjectId)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 200
        && (!('structuralSystem' in data) || (data.structuralSystem is string && data.structuralSystem.size() <= 200))
        && (!('designCode' in data) || (data.designCode is string && data.designCode.size() <= 200))
        && (!('activeRevisionId' in data) || (data.activeRevisionId is string && data.activeRevisionId.size() <= 128))
        && data.revisionCount is number && data.revisionCount >= 0
        && isValidReliability(data.reliabilitySummary)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /structuralProjects/{projectId} {
      allow get: if isValidId(projectId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(projectId)
        && isEmailVerified()
        && isValidStructuralProject(incoming(), projectId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isEmailVerified()
        && isValidStructuralProject(incoming(), projectId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'nameEn', 'structuralSystem', 'designCode',
              'activeRevisionId', 'revisionCount', 'reliabilitySummary', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(projectId) && (isOwner(existing().ownerId) || isAdmin());
    }

    function isValidStructuralModel(data, modelId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'revisionId', 'name', 'sourceApplication', 'sourceVersion', 'originalUnits', 'normalizedUnits', 'provenance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'revisionId', 'name',
          'sourceApplication', 'sourceVersion', 'sourceFileReference',
          'originalUnits', 'normalizedUnits', 'coordinateSystem', 'modelLocked',
          'storyCount', 'gridCount', 'nodeCount', 'frameCount', 'areaCount',
          'materialCount', 'sectionCount', 'loadPatternCount', 'loadCaseCount', 'loadComboCount',
          'provenance', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == modelId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.revisionId is string && isValidId(data.revisionId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.sourceApplication in ['CSI ETABS', 'ETABS Exported Tables']
        && data.sourceVersion is string && data.sourceVersion.size() <= 64
        && (!('sourceFileReference' in data) || (data.sourceFileReference is string && data.sourceFileReference.size() <= 400))
        && data.originalUnits is string && data.originalUnits.size() <= 40
        && data.normalizedUnits is string && data.normalizedUnits.size() <= 40
        && data.provenance is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /structuralModels/{modelId} {
      allow get: if isValidId(modelId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(modelId)
        && isEmailVerified()
        && isValidStructuralModel(incoming(), modelId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if false;
      allow delete: if isValidId(modelId) && (isOwner(existing().ownerId) || isAdmin());
    }

    function isValidStructuralImportJob(data, importId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'revisionId', 'sourceMode', 'sourceHash', 'status', 'reliabilitySummary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'revisionId', 'sourceMode',
          'sourceFileReference', 'sourceHash', 'status', 'currentStep', 'totalSteps',
          'startedAt', 'completedAt', 'errorMessage', 'retryCount', 'reliabilitySummary',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == importId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.sourceMode in ['ETABS_OAPI_LIVE', 'ETABS_EXPORTED_TABLES']
        && data.sourceHash is string && data.sourceHash.size() <= 128
        && data.status in ['PENDING', 'RUNNING', 'PREVIEW_READY', 'CONFIRMED', 'CANCELLED', 'FAILED']
        && isValidReliability(data.reliabilitySummary)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /structuralImports/{importId} {
      allow get: if isValidId(importId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(importId)
        && isEmailVerified()
        && isValidStructuralImportJob(incoming(), importId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if isValidId(importId)
        && isEmailVerified()
        && isValidStructuralImportJob(incoming(), importId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentStep', 'completedAt', 'errorMessage', 'retryCount', 'reliabilitySummary', 'updatedAt'])
          )
        );
      allow delete: if isValidId(importId) && (isOwner(existing().ownerId) || isAdmin());
    }

    function isValidStructuralElementsPacket(data, docId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'modelId', 'revisionId', 'stories', 'grids', 'nodesCount', 'frames', 'areas', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'modelId', 'revisionId',
          'stories', 'grids', 'nodesCount', 'frames', 'areas',
          'loadPatterns', 'loadCases', 'loadCombinations', 'createdAt'
        ])
        && data.id is string && data.id == docId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.stories is list && data.stories.size() <= 150
        && data.grids is list && data.grids.size() <= 25
        && data.nodesCount is number && data.nodesCount >= 0
        && data.frames is list && data.frames.size() <= 400
        && data.areas is list && data.areas.size() <= 250
        && (!('loadPatterns' in data) || (data.loadPatterns is list && data.loadPatterns.size() <= 60))
        && (!('loadCases' in data) || (data.loadCases is list && data.loadCases.size() <= 80))
        && (!('loadCombinations' in data) || (data.loadCombinations is list && data.loadCombinations.size() <= 120))
        && data.createdAt is timestamp;
    }

    match /structuralElements/{elementDocId} {
      allow get: if isValidId(elementDocId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(elementDocId)
        && isEmailVerified()
        && isValidStructuralElementsPacket(incoming(), elementDocId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if false;
      allow delete: if isValidId(elementDocId) && (isOwner(existing().ownerId) || isAdmin());
    }

    function isValidStructuralItemsPacket(data, docId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'modelId', 'revisionId', 'items', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'projectId', 'modelId', 'revisionId', 'items', 'createdAt'])
        && data.id is string && data.id == docId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.items is list && data.items.size() <= 200
        && data.createdAt is timestamp;
    }

    match /structuralMaterials/{materialDocId} {
      allow get: if isValidId(materialDocId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(materialDocId)
        && isEmailVerified()
        && isValidStructuralItemsPacket(incoming(), materialDocId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if false;
      allow delete: if isValidId(materialDocId) && (isOwner(existing().ownerId) || isAdmin());
    }

    match /structuralSections/{sectionDocId} {
      allow get: if isValidId(sectionDocId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(sectionDocId)
        && isEmailVerified()
        && isValidStructuralItemsPacket(incoming(), sectionDocId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if false;
      allow delete: if isValidId(sectionDocId) && (isOwner(existing().ownerId) || isAdmin());
    }

    function isValidStructuralResultsPacket(data, docId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'modelId', 'revisionId', 'analysisResults', 'designResults', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'projectId', 'modelId', 'revisionId', 'analysisResults', 'designResults', 'createdAt'])
        && data.id is string && data.id == docId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.analysisResults is list && data.analysisResults.size() <= 100
        && data.designResults is list && data.designResults.size() <= 50
        && data.createdAt is timestamp;
    }

    match /structuralResults/{resultDocId} {
      allow get: if isValidId(resultDocId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(resultDocId)
        && isEmailVerified()
        && isValidStructuralResultsPacket(incoming(), resultDocId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if false;
      allow delete: if isValidId(resultDocId) && (isOwner(existing().ownerId) || isAdmin());
    }

    function isValidStructuralValidationRecord(data, docId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'revisionId', 'status', 'reliability', 'errorCount', 'warningCount', 'issues', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'revisionId', 'status', 'reliability',
          'checkedAt', 'errorCount', 'warningCount', 'issues', 'createdAt'
        ])
        && data.id is string && data.id == docId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.status in ['PASSED', 'PASSED_WITH_WARNINGS', 'FAILED']
        && isValidReliability(data.reliability)
        && data.errorCount is number && data.errorCount >= 0
        && data.warningCount is number && data.warningCount >= 0
        && data.issues is list && data.issues.size() <= 200
        && data.createdAt is timestamp;
    }

    match /structuralValidations/{validationId} {
      allow get: if isValidId(validationId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(validationId)
        && isEmailVerified()
        && isValidStructuralValidationRecord(incoming(), validationId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if false;
      allow delete: if isValidId(validationId) && (isOwner(existing().ownerId) || isAdmin());
    }

    function isValidStructuralRevision(data, revisionId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'modelId', 'revisionNumber', 'sourceHash', 'immutable', 'reliability', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'modelId', 'revisionNumber', 'label',
          'sourceHash', 'immutable', 'createdByUid', 'createdByName', 'summary',
          'reliability', 'createdAt'
        ])
        && data.id is string && data.id == revisionId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.revisionNumber is number && data.revisionNumber >= 1
        && data.immutable == true
        && isValidReliability(data.reliability)
        && data.createdAt is timestamp;
    }

    match /structuralRevisions/{revisionId} {
      allow get: if isValidId(revisionId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(revisionId)
        && isEmailVerified()
        && isValidStructuralRevision(incoming(), revisionId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if false;
      allow delete: if isValidId(revisionId) && isAdmin();
    }

    function isValidStructuralReport(data, reportId) {
      return data.keys().hasAll(['id', 'ownerId', 'projectId', 'revisionId', 'reportType', 'titleAr', 'titleEn', 'reliability', 'markdownContent', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'revisionId', 'reportType',
          'titleAr', 'titleEn', 'generatedAt', 'reliability',
          'markdownContent', 'metrics', 'createdAt'
        ])
        && data.id is string && data.id == reportId && data.id.size() <= 128
        && data.ownerId is string && isValidId(data.ownerId)
        && data.projectId is string && isValidId(data.projectId)
        && data.reportType in ['IMPORT_AUDIT', 'VALIDATION_SUMMARY', 'MODEL_INVENTORY']
        && isValidReliability(data.reliability)
        && data.markdownContent is string && data.markdownContent.size() <= 50000
        && data.createdAt is timestamp;
    }

    match /structuralReports/{reportId} {
      allow get: if isValidId(reportId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isValidId(reportId)
        && isEmailVerified()
        && isValidStructuralReport(incoming(), reportId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && hasValidStructuralProjectParent(incoming().projectId);
      allow update: if false;
      allow delete: if isValidId(reportId) && (isOwner(existing().ownerId) || isAdmin());
    }
  }
}
